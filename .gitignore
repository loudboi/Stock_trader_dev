# Python / test caches
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/

# Virtual environments / local env files
**/.venv/
**/venv/
**/.env
**/.env.*
!**/.env.example

# Live/paper trading runtime state and audit output
alpaca-bot/pullback*_state.json
alpaca-bot/pullback*_state.json.tmp
alpaca-bot/pullback*_trades.csv
alpaca-bot/pullback*_daily_pnl.csv
