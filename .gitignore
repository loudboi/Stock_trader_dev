alpaca-bot/ibkr_cache/

# Generated research outputs (source code and curated fixtures remain tracked)
alpaca-bot/*_results.png
alpaca-bot/*.log
alpaca-bot/pytest.log
gex-lab/pytest.log

# Point-in-time GEX runtime/research collection
gex-lab/snapshots/

